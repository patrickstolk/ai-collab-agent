# Kopieer naar .env en pas aan:  cp .env.example .env
# .env bevat geheimen: niet delen en niet in versiebeheer opnemen.

# Poort op de host waarop de webinterface bereikbaar is
APP_PORT=3000

# production | test | development  (test/development toont een gekleurde balk in de interface)
APP_ENV=production

# Willekeurige lange sleutel voor sessiecookies, bijv.:  openssl rand -base64 48
# Leeg = de applicatie genereert er zelf een en bewaart die in het datavolume.
SESSION_SECRET=

# Beheerdersaccount bij de eerste start. Laat ADMIN_PASSWORD leeg om in plaats daarvan
# via /setup met een eenmalige installatiecode (zie de logs) een account aan te maken.
# Na de eerste start kunt u ADMIN_PASSWORD weer leegmaken.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Zet op true wanneer de applicatie via HTTPS wordt aangeboden (bijv. achter Traefik)
COOKIE_SECURE=false
# Zet op true achter een reverse proxy (juiste client-IP voor inlogbeperking)
TRUST_PROXY=false
SESSION_HOURS=12

# Uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20

# Maximale wachttijd op resultaten van de sandbox (seconden)
SANDBOX_TIMEOUT_SEC=180

# Optioneel: lokale AI via Ollama op de host (inschakelen bij Instellingen)
OLLAMA_URL=http://host.docker.internal:11434

# Optioneel en standaard NIET gebruikt: officiële API's (aparte betaalde accounts).
# Worden alleen gebruikt als "API-integraties toestaan" bij Instellingen aan staat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
